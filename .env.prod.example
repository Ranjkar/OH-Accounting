# Copy to .env.prod (gitignored) and fill in real values before running
# docker-compose.prod.yml. Every value below is required -- the prod
# compose file has no insecure defaults baked in.

POSTGRES_USER=onholland
POSTGRES_PASSWORD=
POSTGRES_DB=onholland_accounting

# Public URL the frontend will call the API at (through your reverse proxy).
NEXT_PUBLIC_API_URL=https://your-domain.example/api/v1

# All of backend/.env.example's variables also belong here (JWT_SECRET,
# BSN_ENCRYPTION_KEY, CORS_ALLOWED_ORIGINS set to your real frontend
# origin, etc.) -- this file is loaded as the backend service's env_file.
JWT_SECRET=
BSN_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=https://your-domain.example
ANTHROPIC_API_KEY=
