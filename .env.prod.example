# Copy to .env.prod (gitignored) and fill in real values before running
# docker-compose.prod.yml.
#
# BREAKING CHANGE (Phase 17.4, audit 6.4): the backend now REFUSES TO START
# when ENVIRONMENT is not development/dev/test/testing and any guarded secret
# is unset, blank, or still a value that is public in this repository.
# Previously it only logged a warning, so a deployment that omitted these
# variables booted successfully, passed /health, and encrypted real BSNs,
# bank tokens and MFA secrets under committed keys. Fill in every value below
# or the stack will not come up -- that is intentional.

POSTGRES_USER=onholland
POSTGRES_PASSWORD=
POSTGRES_DB=onholland_accounting

# Public URL the frontend will call the API at (through your reverse proxy).
# NOTE (audit 6.10, NOT fixed in Phase 17): Next.js inlines NEXT_PUBLIC_* at
# BUILD time, but frontend/Dockerfile has no matching ARG and this file is
# consumed at RUNTIME -- so this value does not currently reach the browser
# bundle. See docs/PHASE_17_SECURITY_REMEDIATION.md "manual operations".
NEXT_PUBLIC_API_URL=https://your-domain.example/api/v1

# Selects fail-closed secret and CORS validation. See
# backend/app/core/config.py and app/main.py::_validate_cors_origins.
ENVIRONMENT=production

# ---- Application secrets (backend env_file) ----
# All five are REQUIRED at ENVIRONMENT=production. Generate them with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                 # JWT_SECRET
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"   # the three Fernet keys
#   python -c "import secrets; print(secrets.token_urlsafe(32))"                 # BILLING_WEBHOOK_SECRET
JWT_SECRET=

# Employee BSNs at rest.
BSN_ENCRYPTION_KEY=
# Open Banking access/refresh tokens at rest -- a SEPARATE key from BSN.
# Was missing from this template entirely before Phase 17.4.
OPEN_BANKING_TOKEN_ENCRYPTION_KEY=
# TOTP MFA secrets at rest -- a third SEPARATE key. Was missing from this
# template entirely before Phase 17.4.
MFA_SECRET_ENCRYPTION_KEY=
# Billing webhook HMAC verification. Was missing from this template entirely
# before Phase 17.4.
BILLING_WEBHOOK_SECRET=

# Comma-separated older keys. Leave EMPTY except while a rotation is in
# progress, and only after taking a database backup and reading
# docs/encryption-key-rotation.md. Migrate existing ciphertext with
# backend/scripts/rotate_encryption_keys.py before removing a key from here.
BSN_ENCRYPTION_KEY_PREVIOUS=
OPEN_BANKING_TOKEN_ENCRYPTION_KEY_PREVIOUS=
MFA_SECRET_ENCRYPTION_KEY_PREVIOUS=

# Must be your public https origin(s). Refused at startup if it contains a
# wildcard, a private/loopback/link-local address, or a plain http:// origin.
CORS_ALLOWED_ORIGINS=https://your-domain.example

ANTHROPIC_API_KEY=

# Structured JSON log level.
LOG_LEVEL=INFO

# ---- Outbound email (Phase 22) ----
# EMAIL_PROVIDER: "none" (default -- messages are only logged to email_outbox
#   and invitation/reset links are shown in the UI instead), "smtp", or
#   "resend" (https://resend.com transactional API).
# APP_BASE_URL: public origin of the frontend, used to build links in emails.
# SMTP_* are only read when EMAIL_PROVIDER=smtp. Port 587 with STARTTLS by
# default; set SMTP_USE_SSL=true (and usually SMTP_PORT=465) for implicit TLS.
# RESEND_API_KEY is only read when EMAIL_PROVIDER=resend.
# Credentials never appear in any API response; /admin/email reports only
# WHICH variables are missing. Rate limits are per rolling hour.
EMAIL_PROVIDER=none
EMAIL_FROM_ADDRESS=no-reply@localhost
EMAIL_FROM_NAME=OnHolland Accounting
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
RESEND_API_KEY=

# Runtime address the frontend container uses for its same-origin /api/v1 proxy.
# Inside the compose network the backend service is reachable as "backend".
BACKEND_INTERNAL_URL=http://backend:8000

# ---- Phase 26: annual client agreements (ship dark; enable after acceptance) ----
# See backend/.env.example for the meaning of each flag. Keep both false until
# the contract template has been reviewed by legal counsel AND acceptance
# testing on a staging copy has passed.
CONTRACTS_ENABLED=false
CONTRACTS_EMAIL_AUTOMATION_ENABLED=false
CONTRACTS_SCHEDULER_INTERVAL_MINUTES=60
CONTRACTS_SIGNING_PROVIDER=internal
