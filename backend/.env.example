DATABASE_URL=postgresql+psycopg://onholland:onholland@localhost:5432/onholland_accounting

# Generate real values before any non-local use -- see the warnings this
# app logs at startup if either is left at its insecure placeholder.
JWT_SECRET=change-me-in-production
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BSN_ENCRYPTION_KEY=
# Comma-separated older keys, only while a key rotation is in progress --
# see docs/encryption-key-rotation.md. Empty otherwise.
BSN_ENCRYPTION_KEY_PREVIOUS=

ANTHROPIC_API_KEY=
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_BYTES=20971520

# Comma-separated list of frontend origins allowed to call this API.
# Never "*" once credentials/cookies are involved.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sensitive-endpoint rate limiting (requests per minute, per client IP).
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=30

# Account lockout after repeated failed logins.
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# KVK (Chamber of Commerce) company lookup. Leave both unset to use KVK's
# own published TEST sandbox automatically (see app/services/kvk_provider.py)
# -- never leave unset in production, where you need a real signed KVK
# agreement and paid API key.
KVK_API_KEY=
KVK_API_BASE_URL=

# Structured JSON log level (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO
