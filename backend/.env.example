DATABASE_URL=postgresql+psycopg://onholland:onholland@localhost:5432/onholland_accounting

# development | dev | test | testing  -> insecure placeholder secrets WARN
# anything else (production, staging) -> the app REFUSES TO START while any
# guarded secret is still its committed placeholder value. Phase 17.4
# (audit 6.4): previously this only ever warned, so a deployment that forgot
# these variables booted fine, passed /health, and encrypted real BSNs,
# bank tokens and MFA secrets under keys that are public in this repository.
ENVIRONMENT=development

# Generate real values before any non-local use. Every one of the five below
# is required outside a permissive ENVIRONMENT -- see the startup refusal
# message, which names the offenders and how to generate each one.
# Nothing here ever prints a key value.
JWT_SECRET=change-me-in-production
# python -c "import secrets; print(secrets.token_urlsafe(48))"

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BSN_ENCRYPTION_KEY=
# Comma-separated older keys, only while a key rotation is in progress --
# see docs/encryption-key-rotation.md. Empty otherwise.
BSN_ENCRYPTION_KEY_PREVIOUS=

# Open Banking access/refresh tokens at rest (app/core/token_crypto.py).
# A SEPARATE key from BSN, so one compromised key never exposes both classes.
# Was missing from this template entirely before Phase 17.4.
OPEN_BANKING_TOKEN_ENCRYPTION_KEY=
OPEN_BANKING_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# TOTP MFA secrets at rest (app/core/mfa_crypto.py). Also a separate key.
# The most security-critical of the three: whoever can decrypt a TOTP seed
# can generate valid codes indefinitely. Was missing from this template
# entirely before Phase 17.4.
MFA_SECRET_ENCRYPTION_KEY=
MFA_SECRET_ENCRYPTION_KEY_PREVIOUS=

# HMAC secret verifying billing-provider webhooks. Inert while the provider
# is the sandbox stub, but must be real before one is connected.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
BILLING_WEBHOOK_SECRET=

# To migrate existing ciphertext onto a new current key for any of the three
# classes above, run (after a database backup):
#   .venv/bin/python scripts/rotate_encryption_keys.py --dry-run
#   .venv/bin/python scripts/rotate_encryption_keys.py --yes

ANTHROPIC_API_KEY=
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_BYTES=20971520

# Comma-separated list of frontend origins allowed to call this API.
# Never "*" once credentials/cookies are involved. Outside a permissive
# ENVIRONMENT the app refuses to start if this contains a wildcard, a
# private/loopback/link-local address, or a plain http:// origin -- see
# app/main.py::_validate_cors_origins (Phase 17.4, audit 6.9/8.1).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sensitive-endpoint rate limiting (requests per minute, per client IP).
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=30

# Account lockout after repeated failed logins.
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# KVK (Chamber of Commerce) company lookup. Leave both unset to use KVK's
# own published TEST sandbox automatically (see app/services/kvk_provider.py)
# -- never leave unset in production, where you need a real signed KVK
# agreement and paid API key.
KVK_API_KEY=
KVK_API_BASE_URL=

# Structured JSON log level (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO
